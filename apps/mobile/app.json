{
  "expo": {
    "name": "Maromba",
    "slug": "gymapp-maromba",
    "scheme": "maromba",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0C",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymapp.maromba"
    },
    "android": {
      "package": "com.gymapp.maromba",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolha uma foto pro seu perfil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://192.168.0.101:3333"
    }
  }
}
